{ config, pkgs, pkgsStable, lib, ... }:

let
  zabrzeVersion = "0.7.3";
  zabrzePlatform =
    if pkgs.stdenv.hostPlatform.system == "x86_64-linux" then
      {
        suffix = "x86_64-unknown-linux-gnu";
        hash = "sha256-qYwe1xzOfdV/1svpUirljsfo59imr6EvPblIQQJBVko=";
      }
    else if pkgs.stdenv.hostPlatform.system == "aarch64-linux" then
      {
        suffix = "aarch64-unknown-linux-gnu";
        hash = "sha256-TNGrRAOLNJAQl5hwYE3d0y+rN0QaNH4F6O12XiyiqsA=";
      }
    else if pkgs.stdenv.hostPlatform.system == "aarch64-darwin" then
      {
        suffix = "aarch64-apple-darwin";
        hash = "sha256-tX7kabOmOev5D4piGOTLeIfGqI1bJvH8W9cXV+oyDkw=";
      }
    else
      null;

  zabrze =
    if zabrzePlatform == null then
      null
    else
      pkgs.stdenvNoCC.mkDerivation rec {
        pname = "zabrze";
        version = zabrzeVersion;

        src = pkgs.fetchurl {
          url = "https://github.com/Ryooooooga/zabrze/releases/download/v${version}/zabrze-v${version}-${zabrzePlatform.suffix}.tar.gz";
          hash = zabrzePlatform.hash;
        };

        # Release tarball contains a bare binary without a top-level directory,
        # so unpack without the default single-directory expectation.
        unpackPhase = ''
          runHook preUnpack
          tar -xzf "$src"
          runHook postUnpack
        '';

        installPhase = ''
          install -Dm755 zabrze "$out/bin/zabrze"
        '';

        meta = with lib; {
          description = "ZSH abbreviation expansion plugin";
          homepage = "https://github.com/Ryooooooga/zabrze";
          license = licenses.mit;
          platforms = [
            "x86_64-linux"
            "aarch64-linux"
            "aarch64-darwin"
          ];
          sourceProvenance = [ sourceTypes.binaryNativeCode ];
        };
      };

  ghosttyTerminfo = pkgs.runCommand "ghostty-terminfo" {
    nativeBuildInputs = [ pkgs.ncurses ];
  } ''
    mkdir -p "$out"
    tic -x -o "$out" ${./ghostty.terminfo}
  '';
in
{
  home.username = "{{ .chezmoi.username }}";
  home.homeDirectory = "{{ .chezmoi.homeDir }}";
  home.stateVersion = "25.11"; # Please read the comment before changing.

  assertions = [
    {
      assertion = zabrzePlatform != null;
      message = "zabrze is only available for x86_64-linux, aarch64-linux, and aarch64-darwin.";
    }
  ];

  home.packages = [
    # 開発環境で使うツール
    pkgs.mise
    pkgsStable.direnv
    pkgs.starship
    pkgs.colima
    pkgs.docker
    pkgs.docker-compose
    pkgs.pnpm
    pkgs.zsh
    pkgs.caddy
    pkgsStable.zed-editor
    # direnv, zed-editor: stable pin で管理
    # colima: stable の依存 lima が insecure 扱いになることがあるため unstable を使用

    # Language Servers
    pkgs.typescript-language-server
    pkgs.typescript

    # AI
{{ if eq .chezmoi.os "linux" }}
    pkgs.bubblewrap # required by claude-code sandbox
    pkgs.socat # required by claude-code sandbox
{{ end }}

    # Git
    pkgs.gh

    # 準標準
    pkgs._1password-cli
    pkgs.jq
    pkgs.lsof
    pkgs.net-tools
    pkgs.nano
    pkgs.unzip
    pkgs.wget
    pkgs.ffmpeg # learn-it の解説動画のエンコード

    # 標準コマンドの代替(高速・多機能)
    pkgs.fd
    pkgs.eza
    pkgs.lsd
    pkgs.ripgrep
    pkgs.bat
    pkgs.fzf
    pkgs.colordiff

{{ if eq .chezmoi.os "darwin" }}
    # 標準コマンドのGNU版統一 (macOS をLinuxに寄せる)
    pkgs.coreutils-full
    pkgs.diffutils
    pkgs.findutils
    pkgs.gnused
    pkgs.gnugrep
    pkgs.gawk
    pkgs.gnutar
{{ end }}
  ] ++ [
    zabrze
  ];

  # Ghostty が設定する TERM=xterm-ghostty を、ncurses が標準で検索する
  # ~/.terminfo から解決できるようにする。
  home.file.".terminfo/x/xterm-ghostty".source =
    "${ghosttyTerminfo}/x/xterm-ghostty";

{{- if eq .chezmoi.os "darwin" }}

  # Nixpkgs の OpenSSL を使うツール (curl、wget など) が検証に使う CA バンドル。
  # macOS では未設定だと nix-daemon.sh が Nix の default profile の cacert を指す。
  # この cacert は Nix のインストール時のまま更新されないため、flake の nixpkgs に追従させる。
  # Linux では nix-daemon.sh がディストリの CA バンドルを指すので上書きしない。
  home.sessionVariables.NIX_SSL_CERT_FILE = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
{{- end }}

  # Pueue: CLI process scheduler and manager
  # `pueue add <command>` でタスク投入、`pueue status` で確認。
  services.pueue.enable = true;

{{- if and .localLLM (eq .chezmoi.os "darwin") }}

  # ローカル LLM のルータをログイン時から常駐させ、https://llama.localhost で公開する (local-llm/serve.sh)。
  # ルータ自体は軽い。モデルの重みはリクエストが来たら読み込み、アイドルで解放する (local-llm/presets.ini)。
  # llama.cpp は home.packages に入れず PATH で渡す。nix profile の whisper-cpp と libggml が衝突するため。
  launchd.agents.local-llm = {
    enable = true;
    config = {
      ProgramArguments = [
        "${config.home.homeDirectory}/.local/share/mise/shims/portless"
        "llama"
        "{{ .chezmoi.workingTree }}/local-llm/serve.sh"
      ];
      EnvironmentVariables.PATH = lib.concatStringsSep ":" [
        "${pkgs.llama-cpp}/bin"
        "${config.home.profileDirectory}/bin"
        "${config.home.homeDirectory}/.local/share/mise/shims"
        "/usr/bin"
        "/bin"
        "/usr/sbin"
        "/sbin"
      ];
      RunAtLoad = true;
      KeepAlive = true;
      StandardOutPath = "${config.home.homeDirectory}/Library/Logs/local-llm.log";
      StandardErrorPath = "${config.home.homeDirectory}/Library/Logs/local-llm.log";
    };
  };
{{- end }}

  programs.tmux.enable = true;

  home.activation.installCursorAgent = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    cursorAgentPath="${config.home.homeDirectory}/.local/bin/cursor-agent"
    homeBinDir="${config.home.homeDirectory}/bin"

    if [ ! -x "$cursorAgentPath" ]; then
      $DRY_RUN_CMD bash -c "$(${pkgs.curl}/bin/curl -fsSL https://cursor.com/install)"
    fi

    $DRY_RUN_CMD mkdir -p "$homeBinDir"
    if [ -x "$cursorAgentPath" ]; then
      $DRY_RUN_CMD ln -sf "$cursorAgentPath" "$homeBinDir/agent"
    fi
  '';

  home.activation.installMiseTools = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    miseConfigPath="${config.home.homeDirectory}/.config/mise/config.toml"
    export PATH="${pkgs.mise}/bin:$PATH"

    if [ -f "$miseConfigPath" ]; then
      $DRY_RUN_CMD ${pkgs.mise}/bin/mise install
      $DRY_RUN_CMD ${pkgs.mise}/bin/mise reshim
    fi
  '';

  nixpkgs.config.allowUnfree = true; # Allow unfree packages

  # Suppress version mismatch warning: we intentionally use nixos-unstable nixpkgs
  # with release-26.05 home-manager because newer home-manager releases are not always available.
  home.enableNixpkgsReleaseCheck = false;

  programs.home-manager.enable = true; # Let Home Manager install and manage itself.
}
