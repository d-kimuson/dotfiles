#!/usr/bin/env bash

# ====================
# Local Variables
# ====================
export CHEZMOI_WORKING_TREE="{{ .chezmoi.workingTree }}"

# ====================
# Env Dependent
# ====================
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "ubuntu") }}
export CFLAGS=-I/usr/include/openssl
export LDFLAGS=-L/usr/lib
{{- end }}

# ====================
# Nix daemon environment
# ====================
# Keep Nix available even when macOS resets PATH after an inherited Nix shell exported
# __ETC_PROFILE_NIX_SOURCED=1 and the installer hook would otherwise no-op here.
NIX_DAEMON_PROFILE=/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
NIX_DAEMON_BIN=/nix/var/nix/profiles/default/bin
if [ -e "$NIX_DAEMON_PROFILE" ] && [[ ":$PATH:" != *":$NIX_DAEMON_BIN:"* ]]; then
  unset __ETC_PROFILE_NIX_SOURCED
  source "$NIX_DAEMON_PROFILE"
fi
unset NIX_DAEMON_PROFILE NIX_DAEMON_BIN

# ====================
# Zsh Completion
# ====================
fpath=(
  ${HOME}/.nix-profile/share/zsh/site-functions
  $fpath
)
autoload -Uz compinit && compinit

# ====================
# activate tools
# ====================
eval "$(mise activate zsh --shims)"
eval "$(starship init zsh)"
eval "$(direnv hook zsh)"

# ====================
# zabrze (abbr)
# ====================
if command -v zabrze >/dev/null 2>&1; then
  eval "$(zabrze init --bind-keys)"
fi

# ====================
# fzf key bindings (fuzzy history etc.)
# ====================
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# ====================
# active other rc files
# ====================
source ${CHEZMOI_WORKING_TREE}/shell/sharedrc.sh
if [ -f ${CHEZMOI_WORKING_TREE}/shell/localrc.sh ]; then
  source ${CHEZMOI_WORKING_TREE}/shell/localrc.sh
fi
export DIRENV_WARN_TIMEOUT=1m
