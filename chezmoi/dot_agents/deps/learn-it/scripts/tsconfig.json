{
  "extends": "@tsconfig/strictest",
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // ステージの page.evaluate がブラウザの型を使う
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
