{
  "mcpServers": {
    "obsidian": {
      "layer": "core",
      "type": "stdio",
      "command": "${OBSIDIAN_VAULT_PATH}/.obsidian/plugins/mcp-tools/bin/mcp-server",
      "args": [],
      "env": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}"
      }
    },
    "esa": {
      "layer": "core",
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@esaio/esa-mcp-server"],
      "env": {
        "ESA_ACCESS_TOKEN": "${ESA_ACCESS_TOKEN}",
        "LANG": "ja"
      },
      "remote": true
    },
    "atlassian": {
      "layer": "core",
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "remote": true,
      "requiresEnv": ["ATLASSIAN_MCP_ENABLED"]
    },
    "kimuson": {
      "layer": "personal",
      "type": "http",
      "url": "https://mcp.kimuson.dev/mcp",
      "remote": true
    }
  }
}
